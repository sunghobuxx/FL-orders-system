{
  "expo": {
    "name": "FruitLife",
    "slug": "fruitlife",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fruitlife.app",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "카메라를 사용하지 않습니다.",
        "NSPhotoLibraryUsageDescription": "문의 사진을 첨부하기 위해 사진 라이브러리에 접근합니다."
      }
    },
    "android": {
      "package": "com.fruitlife.order",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "문의 사진을 첨부하기 위해 사진 라이브러리에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b96a9d08-d202-43f1-988a-44b767fa9e4c"
      }
    },
    "owner": "buxx1982",
    "scheme": "fruitlife",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
